# Copy to configs/deal-ws.local.env and fill in your local paths and endpoints.
# Unified 8-GPU single-host layout: 4 train GPUs (TP=4) + 4 rollout GPUs (4x TP=1).
BENCHMARK=deal-ws
# Supported models: gemma4-e4b-it | qwen3.5-9b
MODEL=gemma4-e4b-it

BASE_MODEL=/path/to/gemma-4-E4B-it
DATA_DIR=./data/deal-ws
RUN_DIR=./runs/deal-ws-gemma4

# 4 train GPUs + 4 rollout GPUs (8 GPUs total)
TRAIN_GPUS=0,1,2,3
ROLLOUT_GPUS=4,5,6,7

# Frozen initial policy (pi_theta_0) for SRE self-rubric & self-scoring (hardgate enabled).
# Host on a separate GPU/host (e.g. via scripts/serve_frozen_model.sh) or OpenAI-compatible API.
SELF_REWARD_BASE_URL=http://127.0.0.1:29040/v1
SELF_REWARD_MODEL=gemma4-e4b-it
SELF_REWARD_API_KEY_FILE=/path/to/secrets/self-reward-api-key

# External user simulator (GT judge for the single live anchor rollout).
# Paper setting: Gemma4-31B-IT behind an OpenAI-compatible API.
GT_BASE_URL=https://YOUR-GT-JUDGE-SERVICE/v1
GT_MODEL=gemma-4-31B-it
GT_API_KEY_FILE=/path/to/secrets/gt-api-key

# Leave empty to start from BASE_MODEL, or point to an HF checkpoint produced by this repo.
RESUME_HF=

# Ports (adjust if running multiple jobs on the same host)
MASTER_PORT=30479
RAY_DASHBOARD_PORT=30480
POLAR_ROLLOUT_PORT=30595
POLAR_GATEWAY_PORT=30596
SGLANG_ROUTER_PORT=30597
WSCLAW_JUDGE_PROXY_PORT=28198
WSCLAW_JUDGE_WORKER_PORT=28200

# Long-context KV cache concurrency cap per rollout engine
ROLLOUT_MAX_RUNNING_REQUESTS=32

# Optional: path to Claude Code CLI used by the DEAL-WS native judge sidecar
CLAUDE_BIN=

# Optional: override auto-detected host IP
HOST_IP=
